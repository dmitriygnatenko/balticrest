{% extends 'admin/base.html.twig' %}

{% block content %}
    <div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title">Удаление статьи</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            Подтвердите удаление статьи <b>{{ title }}</b>
                            <p class="text-center">
                                <button type="submit" class="btn btn-danger btn-fill">Удалить</button>
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}