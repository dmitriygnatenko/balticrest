<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, shrink-to-fit=no' name='viewport' />
    <title>Администрирование {{ app_name }}</title>
    {% block admin_css_head %}
        {% if build_assets %}
            <link rel="stylesheet" type="text/css" href="{{ asset('static/admin/build/admin.css') }}">
        {% else %}
            <link rel="stylesheet" type="text/css" href="{{ asset('static/admin/src/bootstrap/css/bootstrap.min.css') }}">
            <link rel="stylesheet" type="text/css" href="{{ asset('static/admin/src/font-awesome/css/font-awesome.css') }}">
            <link rel="stylesheet" type="text/css" href="{{ asset('static/admin/src/light-bootstrap/css/light-bootstrap-dashboard.css') }}">
        {% endif %}
    {% endblock %}
</head>
<body>
<div class="wrapper">
    {{ include('admin/include/sidebar.html.twig') }}
    <div class="main-panel">
        {{ include('admin/include/navbar.html.twig') }}
        {% block content %}{% endblock %}
    </div>
</div>
{% block admin_js_body %}
    {% if build_assets %}
        <script src="{{ asset('static/admin/build/admin.js') }}"></script>
    {% else %}
        <script src="{{ asset('static/admin/src/jquery/js/jquery.min.js') }}"></script>
        <script src="{{ asset('static/admin/src/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
        <script src="{{ asset('static/admin/src/bootstrap/js/bootstrap-datepicker.js') }}"></script>
        <script src="{{ asset('static/admin/src/bootstrap/js/bootstrap-notify.js') }}"></script>
        <script src="{{ asset('static/admin/src/bootstrap/js/bootstrap-switch.js') }}"></script>
        <script src="{{ asset('static/admin/src/light-bootstrap/js/light-bootstrap-dashboard.js') }}"></script>
    {% endif %}
{% endblock %}
</body>
</html>
