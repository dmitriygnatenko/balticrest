<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, shrink-to-fit=no' name='viewport' />
    <title>Администрирование {{ app_name }}</title>
    {% block admin_css_head %}
        {{ include('admin/include/css_body_main.html.twig') }}
        {{ include('admin/include/css_body_elfinder.html.twig') }}
    {% endblock %}
</head>
<body>
<div class="wrapper">
    {{ include('admin/include/sidebar.html.twig') }}
    <div class="main-panel">
        {{ include('admin/include/navbar.html.twig') }}
        {% block content %}{% endblock %}
    </div>
</div>
{% block admin_js_body %}
    {{ include('admin/include/js_body_main.html.twig') }}
    {{ include('admin/include/js_body_elfinder.html.twig') }}
{% endblock %}
</body>
</html>
