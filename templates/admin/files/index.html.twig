{% extends 'admin/base.html.twig' %}

{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div id="elfinder"></div>
            </div>
        </div>
    </div>
{% endblock %}

{% block admin_js_body %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $('#elfinder').elfinder(
                {
                    cssAutoLoad : false,
                    baseUrl : "./",
                    url : "{{ path('admin.files.connector') }}",
                    lang: "ru",
                    height: '100%',
                    width: '100%',
                    resizable : false
                }
            );
        });
    </script>
{% endblock %}