<div class="sidebar" data-color="blue">
    <div class="sidebar-wrapper">
        <div class="logo">
            <a href="/{{ app.request.baseUrl }}" class="simple-text" target="_blank">
                {{ app_name }}
            </a>
        </div>
        <ul class="nav">
            <li class="nav-item {% if app.request.requestUri starts with '/admin/point' %}active{% endif %}">
                <a class="nav-link" href="{{ path('admin.point_list') }}">
                    <i class="fa fa-map-marker"></i>
                    <p>Объекты</p>
                </a>
            </li>
            <li class="nav-item {% if app.request.requestUri starts with '/admin/news' %}active{% endif %}">
                <a class="nav-link" href="{{ path('admin.news_list') }}">
                    <i class="fa fa-newspaper-o"></i>
                    <p>Новости</p>
                </a>
            </li>
            <li class="nav-item {% if app.request.requestUri starts with '/admin/article' %}active{% endif %}">
                <a class="nav-link" href="{{ path('admin.article_list') }}">
                    <i class="fa fa-file-text"></i>
                    <p>Статьи</p>
                </a>
            </li>
        </ul>
    </div>
</div>