{% extends 'admin/base.html.twig' %}

{% form_theme form 'admin/form/custom_theme.html.twig' %}

{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">{{ title }}</h4>
                        </div>
                        <div class="card-body">
                            {{ form_start(form) }}

                            <div class="row">
                                <div class="col-md-12">
                                    {{ form_row(form.email) }}
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    {{ form_row(form.is_active) }}
                                </div>
                            </div>

                            <p class="text-center">
                                <button type="submit" class="btn btn-primary btn-fill">Сохранить</button>
                            </p>

                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}