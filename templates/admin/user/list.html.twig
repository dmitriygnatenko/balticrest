{% extends 'admin/base.html.twig' %}

{% block content %}
    <div class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <div class="float-left">
                                <h4 class="card-title">Список пользователей</h4>
                            </div>
                            <div class="float-right">
                                <a class="btn btn-primary btn-fill btn-icon" href="{{ path('admin.user_add') }}" role="button" title="Добавить">
                                    <i class="fa fa-plus"></i>
                                </a>
                            </div>
                        </div>
                        <div class="card-body">
                            {% for label, messages in app.flashes(['success', 'warning', 'danger', 'info', 'primary']) %}
                                {% for message in messages %}
                                    <div class="alert alert-{{ label }}">
                                        <span>{{ message }}</span>
                                    </div>
                                {% endfor %}
                            {% endfor %}

                            <table class="table table-hover table-bordered">
                                <thead>
                                <th>ID</th>
                                <th>Адрес эл. почты</th>
                                <th>Активный</th>
                                <th></th>
                                </thead>
                                <tbody>
                                {% for user in users %}
                                    <tr>
                                        <td>{{ user.id }}</td>
                                        <td>{{ user.email }}</td>
                                        {% if user.isActive %}
                                            <td class="text-success">Да</td>
                                        {% else %}
                                            <td class="text-danger">Нет</td>
                                        {% endif %}
                                        <td style="width: 55px; padding-right: 0;">
                                            <a class="btn btn-primary btn-fill btn-icon" href="{{ path('admin.user_edit', {id: user.id}) }}" role="button" title="Редактировать">
                                                <i class="fa fa-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
