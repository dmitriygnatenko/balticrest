<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Balticrest - {% endblock %}</title>
    <meta name="description" content="{% block description %}{% endblock %}">
    <meta name="keywords" content="{% block keywords %}{% endblock %}">
    {% block balticrest_css_head %}
        {% if build_assets %}
            <link rel="stylesheet" type="text/css" href="{{ asset('static/balticrest/build/balticrest_main.css') }}">
        {% else %}
            <link rel="stylesheet" type="text/css" href="{{ asset('static/balticrest/src/bootstrap/css/bootstrap.css') }}">
            <link rel="stylesheet" type="text/css" href="{{ asset('static/balticrest/src/pushy/css/pushy.css') }}">
            <link rel="stylesheet" type="text/css" href="{{ asset('static/balticrest/src/animate/css/animate.css') }}">
            <link rel="stylesheet" type="text/css" href="{{ asset('static/balticrest/src/font-awesome/css/font-awesome.css') }}">
            <link rel="stylesheet" type="text/css" href="{{ asset('static/balticrest/src/balticrest/css/main.css') }}">
            <link rel="stylesheet" type="text/css" href="{{ asset('static/balticrest/src/balticrest/css/adaptive.css') }}">
        {% endif %}
    {% endblock %}
    {% block balticrest_js_head %}
        {{ include('balticrest/include/google_analytics.html.twig') }}
        {{ include('balticrest/include/google adsense.html.twig') }}
        <!--[if lt IE 9]>
        <script src="{{ asset('static/balticrest/src/html5shiv/js/html5shiv.min.js') }}"></script>
        <script src="{{ asset('static/balticrest/src/respond/js/respond.min.js') }}"></script>
    <![endif]-->
    {% endblock %}
</head>
<body {% block body_attr %}{% endblock %}>
    {% block body %}{% endblock %}
    {% block balticrest_js_body %}
        {% if build_assets %}
            <script src="{{ asset('static/balticrest/build/balticrest_main.js') }}"></script>
        {% else %}
            <script src="{{ asset('static/balticrest/src/jquery/js/jquery.min.js') }}"></script>
            <script src="{{ asset('static/balticrest/src/bootstrap/js/bootstrap.min.js') }}"></script>
            <script src="{{ asset('static/balticrest/src/balticrest/js/all_scr.js') }}"></script>
        {% endif %}
    {% endblock %}
</body>
</html>