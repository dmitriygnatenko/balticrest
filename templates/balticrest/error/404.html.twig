{% extends 'balticrest/base_left_top_menu.html.twig' %}

{% set uri = app.request.requestUri %}

{% if uri starts with '/en/' %}
    {% set locale = 'en' %}
{% elseif uri starts with '/de/' %}
    {% set locale = 'de' %}
{% elseif uri starts with '/cn/' %}
    {% set locale = 'cn' %}
{% elseif uri starts with '/lt/' %}
    {% set locale = 'lt' %}
{% elseif uri starts with '/pl/' %}
    {% set locale = 'pl' %}
{% else %}
    {% set locale = 'ru' %}
{% endif %}

{% block body_attr %}class="innerpage"{% endblock %}

{% block title %}{{ parent() }} {% trans into locale %}error.404.header{% endtrans %} {% endblock %}

{% block content %}

    <div class="container page_info">
        <div class="col_md_12">
            <h1>{% trans into locale %}error.404.header{% endtrans %}</h1>
            <div class="return-block">
                <a href="{{ path('main') }}">&crarr; {% trans %}links.to_mainpage{% endtrans %}</a>
            </div>
        </div>
    </div>

    <div class="container contant">
        <div class="row">
            <div class="col-md-12 basic">
                <div class="post_content">
                    {% set city = global_service.defaultCity %}
                    {% set link = path('map', {city: city, '_locale': locale}) %}
                    {% set city_gen = 'cities_genitive.' ~ city %}

                    {% trans with {'%city_gen%': city_gen|trans({}, 'messages', locale), '%link%': link} into locale %}error.404.text{% endtrans %}
                </div>
            </div>
        </div>
    </div>

{% endblock %}