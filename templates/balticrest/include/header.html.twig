<div class="container-fluid header inner_head">

    {% set cities = global_service.cities %}
    {% set languages = global_service.languages %}

    <div class="fixed_w">
        <div class="row">
            <div class="col-md-12">

                {% set city = app.request.get('city') %}
                {% if city %}
                    <div class="dropdown city-selector">
                        <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                            {% if cities[city] is defined %}
                                <img src="{{ asset(cities[city].image) }}" title="'{{ cities[city].title|trans }}">
                                {{ cities[city].title|trans }}
                            {% endif %}
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu">
                            {% for key, values in cities %}
                                {% if key != city %}
                                    {% set route_params = app.request.attributes.get('_route_params')|merge({'city': key}) %}
                                    <li>
                                        <a href="{{ path(app.request.attributes.get('_route'), route_params) }}">
                                            <img src="{{ asset(values.image) }}" title="{{ values.title|trans }}">
                                            {{ values.title|trans }}
                                        </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {% set language = app.request.locale %}
                <div class="dropdown language-selector">
                    <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        {% if languages[language] is defined %}
                            <img src="{{ asset(languages[language].image) }}" title="{{ languages[language].title }}">
                        {% endif %}
                        <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu">
                        {% for key, values in languages %}
                            {% if key != language %}
                                {% set route_params = app.request.attributes.get('_route_params')|merge({'_locale': key}) %}
                                <li>
                                    <a href="{{ path(app.request.attributes.get('_route'), route_params) }}">
                                        <img src="{{ asset(values.image) }}" title="{{ values.title }}">
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>

                <div class="input-group search">
                    <input type="text" class="form-control" placeholder="{% trans %}header.search.text_placeholder{% endtrans %}">
                    <span class="input-group-btn">
                        <button class="btn btn-default" type="button" title="{% trans %}header.search.btn_title{% endtrans %}">
                            <i class="fa fa-search"></i>
                        </button>
                    </span>
                </div>

            </div>
        </div>
    </div>
</div>