<div class="container-fluid header inner_head">

    {% set cities = global_service.cities %}
    {% set languages = global_service.languages %}

    <div class="fixed_w">
        <div class="row">
            <div class="col-md-12">

                {% set city = app.request.get('city') %}
                {% if city and cities[city] is defined %}
                    <div class="btn-group city-selector">
                        <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown">
                            {% set city_title = 'cities.' ~ cities[city].code  %}
                            {{ city_title|trans }}
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu">
                            {% for key, values in cities %}
                                {% if key != city %}
                                    {% set route_params = app.request.attributes.get('_route_params')|merge({'city': key}) %}
                                    {% set city_title = 'cities.' ~ values.code  %}
                                    <li>
                                        <a href="{{ path(app.request.attributes.get('_route'), route_params) }}">
                                            {{ city_title|trans }}
                                        </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {% set language = app.request.locale %}
                {% if languages[language] is defined and app.request.attributes.get('_route_params') is not null %}
                    <div class="btn-group language-selector">
                        <button type="button" class="btn dropdown-toggle" data-toggle="dropdown">
                            <span class="language icon-{{ language }}"></span>
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu">
                            {% for key, values in languages %}
                                {% if key != language %}
                                    {% set route_params = app.request.attributes.get('_route_params')|merge({'_locale': key}) %}
                                    <li>
                                        <a href="{{ path(app.request.attributes.get('_route'), route_params) }}">
                                            <span class="language icon-{{ key }}"></span>
                                            {{ values.title }}
                                        </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {#
                <div class="input-group search">
                    <input type="text" class="form-control" placeholder="{% trans %}header.search.text_placeholder{% endtrans %}">
                    <span class="input-group-btn">
                        <button class="btn btn-default" type="button" title="{% trans %}header.search.btn_title{% endtrans %}">
                            <i class="fa fa-search"></i>
                        </button>
                    </span>
                </div>
                #}

            </div>
        </div>
    </div>
</div>