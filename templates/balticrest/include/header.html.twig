{% set languages = {
    'ru': {
        'img': 'static/balticrest/images/flags/ru.png',
        'title': 'Русский'
    },
    'en': {
        'img': 'static/balticrest/images/flags/gb.png',
        'title': 'English'
    },
    'de': {
        'img': 'static/balticrest/images/flags/de.png',
        'title': 'Deutsch'
    },
    'pl': {
        'img': 'static/balticrest/images/flags/pl.png',
        'title': 'Polski'
    },
    'lt': {
        'img': 'static/balticrest/images/flags/lt.png',
        'title': 'Lietuvis'
    },
    'cn': {
        'img': 'static/balticrest/images/flags/cn.png',
        'title': '中文'
    },
} %}

{% set cities = {
    'zelenogradsk': {
        'title': 'cities.zelenogradsk'|trans,
        'img': 'static/balticrest/images/cities/zelenogradsk.png',
    },
    'svetlogorsk': {
        'title': 'cities.svetlogorsk'|trans,
        'img': 'static/balticrest/images/cities/svetlogorsk.png',
    },
} %}

<div class="container-fluid header inner_head">

    <div class="fixed_w">
        <div class="row">
            <div class="col-md-12">

                {% set city = app.request.get('city') %}

                <div class="dropdown city-selector">
                    <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        {% if cities[city] is defined %}
                            <img src="{{ asset(cities[city]['img']) }}" title="{{ cities[city]['title'] }}">
                            {{ cities[city]['title'] }}
                        {% endif %}
                        <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu">
                        {% for key, values in cities %}
                            {% if key != city %}
                                {% set route_params = app.request.attributes.get('_route_params')|merge({'city': key}) %}
                                <li>
                                    <a href="{{ path(app.request.attributes.get('_route'), route_params) }}">
                                        <img src="{{ asset(values['img']) }}" title="{{ values['title'] }}">
                                        {{ values['title'] }}
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>

                {% set language = app.request.locale %}
                <div class="dropdown language-selector">
                    <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
                        {% if languages[language] is defined %}
                            <img src="{{ asset(languages[language]['img']) }}" title="{{ languages[language]['title'] }}">
                        {% endif %}
                        <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu">
                        {% for key, values in languages %}
                            {% if key != language %}
                                {% set route_params = app.request.attributes.get('_route_params')|merge({'_locale': key}) %}
                                <li>
                                    <a href="{{ path(app.request.attributes.get('_route'), route_params) }}">
                                        <img src="{{ asset(values['img']) }}" title="{{ values['title'] }}">
                                    </a>
                                </li>
                            {% endif %}
                        {% endfor %}
                    </ul>
                </div>

                <div class="input-group search">
                    <input type="text" class="form-control" placeholder="{% trans %}header.search.text_placeholder{% endtrans %}">
                    <span class="input-group-btn">
                        <button class="btn btn-default" type="button" title="{% trans %}header.search.btn_title{% endtrans %}">
                            <i class="fa fa-search"></i>
                        </button>
                    </span>
                </div>

            </div>
        </div>
    </div>
</div>