{% set languages = {
    'ru': {
        'img': 'static/balticrest/images/flags/ru.png',
        'title': 'Русский'
    },
    'en': {
        'img': 'static/balticrest/images/flags/gb.png',
        'title': 'English'
    },
    'de': {
        'img': 'static/balticrest/images/flags/de.png',
        'title': 'Deutsch'
    },
    'pl': {
        'img': 'static/balticrest/images/flags/pl.png',
        'title': 'Polski'
    },
    'lt': {
        'img': 'static/balticrest/images/flags/lt.png',
        'title': 'Lietuvis'
    },
    'cn': {
        'img': 'static/balticrest/images/flags/cn.png',
        'title': '中文'
    },
} %}

{% set language = app.request.locale %}

<div class="dropdown language-selector">
    <button class="btn btn-default dropdown-toggle" type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
        {% if languages[language] is defined %}
            <img src="{{ asset(languages[language]['img']) }}" title="{{ languages[language]['title'] }}">
        {% endif %}
        <span class="caret"></span>
    </button>
    <ul class="dropdown-menu">
        {% for key, values in languages %}
            {% if key != language %}
                {% set route_params = app.request.attributes.get('_route_params')|merge({'_locale': key}) %}
                <li>
                    <a href="{{ path(app.request.attributes.get('_route'), route_params) }}">
                        <img src="{{ asset(values['img']) }}" title="{{ values['title'] }}">
                    </a>
                </li>
            {% endif %}
        {% endfor %}
    </ul>
</div>