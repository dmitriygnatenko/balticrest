{% set city = app.request.get('city') %}
{% if not city %}
    {% set city = global_service.defaultCity %}
{% endif %}

{% set category = global_service.defaultCategory %}

<div class="menu-btn">&#9776;</div>
<nav class="pushy pushy-left">
    <ul class="side_menu">
        <li>
            <a href="{{ path('main') }}">
                <i class="fa fa-bookmark-o"></i>{% trans %}navigation.menu.main{% endtrans %}
            </a>
        </li>
        <li>
            <a href="{{ path('map', {city: city}) }}">
                <i class="fa fa-map-marker"></i>{% trans %}navigation.menu.map{% endtrans %}
            </a>
        </li>
        <li>
            <a href="{{ path('point_list', {city: city, category: category}) }}">
                <i class="fa fa-list"></i>{% trans %}navigation.menu.point_list{% endtrans %}
            </a>
        </li>
        <li>
            <a href="#">
                <i class="fa fa-video-camera"></i>{% trans %}navigation.menu.webcam{% endtrans %}
            </a>
        </li>
        <li>
            <a href="#">
                <i class="fa fa-newspaper-o"></i>{% trans %}navigation.menu.news{% endtrans %}
            </a>
        </li>
        <li>
            <a href="{{ path('contacts') }}">
                <i class="fa fa-envelope"></i>{% trans %}navigation.menu.contacts{% endtrans %}
            </a>
        </li>
        <li>
            <a href="{{ path('privacy_policy') }}">
                <i class="fa fa-briefcase"></i>{% trans %}navigation.menu.privacy_policy{% endtrans %}
            </a>
        </li>
    </ul>
</nav>