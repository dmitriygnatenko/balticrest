{% extends 'balticrest/base_left_top_menu.html.twig' %}

{% block title %}Тестовая карта{% endblock %}

{% block body_attr %}onload="initialize()" class="inmap innerpage"{% endblock %}

{% block content %}

<!--add-->
<div class="add_place none" id="pl">
    <div class="place_form">
        <i class="fa fa-times close_window" id="close"></i>
        <h3>Add new place<span></span></h3>
        <form>
            <label>Place name:<input type="text"></label>
            <label>latitude:<input type="text"></label>
            <label>longitude:<input type="text"></label>
            <label>Categori:
                <select>
                    <option value="Cafe">Cafe</option>
                    <option value="Bar">Bar</option>
                    <option value="Cinema">Cinema</option>
                    <option value="Shop">Shop</option>
                    <option value="Club">Club</option>
                    <option value="Bank">Bank</option>
                </select>
            </label>
            <a href="#" class="green_btn_header" id="add">Add</a>
        </form>
    </div>
</div>

<!--autorization-->
<div class="add_place none" id="autorized">
    <div class="place_form login_form">
        <i class="fa fa-times close_window" id="closeau"></i>
        <h3>Autorization<span></span></h3>
        <form>
            <label>Login:<input type="text"></label>
            <label>Password:<input type="text"></label>
            <a href="#" class="btn btn-success">Log in</a>
            <a href="#" class="btn btn-primary"><i class="icon-facebook"></i>Log in with Facebook</a>
        </form>
    </div>
</div>

<!-- Site Overlay -->
<div class="site-overlay"></div>
<div id="container">
    <!--Header-->
    <div class="container-fluid header inner_head">

        <div class="fixed_w">
            <div class="row">
                <div class="col-md-12">
                    <a href="index.html" class="logo"><img src="{{ asset('static/balticrest/img/logoin.png') }}" alt="Mycity"/></a>

                    {{ include('balticrest/include/language.html.twig') }}
                    <input type="text" class="search" placeholder="search">
                    <a href="#" class="green_btn_header" id="ad">Add place</a>
                </div>
            </div>
        </div>
    </div>

    {% set city = app.request.attributes.get('city', '') %}
    {% set category = app.request.attributes.get('category', '') %}

    <div class="container-fluid menu mobile">
        <div class="row">
            <div class="col-md-12">
                <span>{% trans %}map.menu.category{% endtrans %}</span>
                <i class="fa fa-times" id="close_menu"></i>
                <ul>
                    <li><a title="{% trans %}map.menu.hotels{% endtrans %}" href="{{ path('map', {city: city, category: 'hotels'}) }}" class="hotel {% if category == 'hotels' %}active{% endif %}"><i class="fa fa-hotel"></i></a></li>
                    <li><a title="{% trans %}map.menu.medicine{% endtrans %}" href="{{ path('map', {city: city, category: 'medicine'}) }}" class="medicine {% if category == 'medicine' %}active{% endif %}"><i class="fa fa-plus-square"></i></a></li>
                    <li><a title="{% trans %}map.menu.cafes{% endtrans %}" href="{{ path('map', {city: city, category: 'cafes'}) }}" class="cafe {% if category == 'cafes' %}active{% endif %}"><i class="fa fa-cutlery"></i></a></li>
                    <li><a title="{% trans %}map.menu.shops{% endtrans %}" href="{{ path('map', {city: city, category: 'shops'}) }}" class="shop {% if category == 'shops' %}active{% endif %}"><i class="fa fa-shopping-cart"></i></a></li>
                    <li><a title="{% trans %}map.menu.banks{% endtrans %}" href="{{ path('map', {city: city, category: 'banks'}) }}" class="bank {% if category == 'banks' %}active{% endif %}"><i class="fa fa-usd"></i></a></li>
                    <li><a title="{% trans %}map.menu.museums{% endtrans %}" href="{{ path('map', {city: city, category: 'museums'}) }}" class="museum {% if category == 'museums' %}active{% endif %}"><i class="fa fa-university"></i></a></li>
                    <li><a title="{% trans %}map.menu.sport{% endtrans %}" href="{{ path('map', {city: city, category: 'sport'}) }}" class="sport {% if category == 'sport' %}active{% endif %}"><i class="fa fa-futbol-o"></i></a></li>
                    <li><a title="{% trans %}map.menu.transport{% endtrans %}" href="{{ path('map', {city: city, category: 'transport'}) }}" class="transport {% if category == 'transport' %}active{% endif %}"><i class="fa fa-bus"></i></a></li>
                    <li class="mobile_menu"><a href="#"><i class="fa fa-bars"></i></a></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div id="map" class="map"></div>

{% endblock %}

{% block javascripts %}
    <script type="text/javascript" src="http://maps.googleapis.com/maps/api/js?key=AIzaSyCsbzuJDUEOoq-jS1HO-LUXW4qo0gW9FNs"></script>
    {{ parent() }}
    {{ encore_entry_script_tags('balticrest_js_map_index') }}
{% endblock %}