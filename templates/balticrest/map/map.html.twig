{% extends 'balticrest/base_left_top_menu.html.twig' %}

{% block title %}Тестовая карта{% endblock %}

{% block body_attr %}onload="initializeMap()" class="inmap innerpage"{% endblock %}

{% block content %}
    <div id="map" class="map"></div>

    {% set city = app.request.attributes.get('city', '') %}
    {% set category = app.request.attributes.get('category', '') %}

    <div class="container-fluid menu mobile">
        <div class="row">
            <div class="col-md-12">
                <span>{% trans %}categories.category{% endtrans %}</span>
                <i class="fa fa-times" id="close_menu"></i>
                <ul>
                    <li><a title="{% trans %}categories.hotels{% endtrans %}" href="{{ path('map', {city: city, category: 'hotels'}) }}" class="hotel {% if category == 'hotels' %}active{% endif %}"><i class="fa fa-hotel"></i></a></li>
                    <li><a title="{% trans %}categories.medicine{% endtrans %}" href="{{ path('map', {city: city, category: 'medicine'}) }}" class="medicine {% if category == 'medicine' %}active{% endif %}"><i class="fa fa-plus-square"></i></a></li>
                    <li><a title="{% trans %}categories.cafes{% endtrans %}" href="{{ path('map', {city: city, category: 'cafes'}) }}" class="cafe {% if category == 'cafes' %}active{% endif %}"><i class="fa fa-cutlery"></i></a></li>
                    <li><a title="{% trans %}categories.shops{% endtrans %}" href="{{ path('map', {city: city, category: 'shops'}) }}" class="shop {% if category == 'shops' %}active{% endif %}"><i class="fa fa-shopping-cart"></i></a></li>
                    <li><a title="{% trans %}categories.banks{% endtrans %}" href="{{ path('map', {city: city, category: 'banks'}) }}" class="bank {% if category == 'banks' %}active{% endif %}"><i class="fa fa-usd"></i></a></li>
                    <li><a title="{% trans %}categories.museums{% endtrans %}" href="{{ path('map', {city: city, category: 'museums'}) }}" class="museum {% if category == 'museums' %}active{% endif %}"><i class="fa fa-university"></i></a></li>
                    <li><a title="{% trans %}categories.sport{% endtrans %}" href="{{ path('map', {city: city, category: 'sport'}) }}" class="sport {% if category == 'sport' %}active{% endif %}"><i class="fa fa-futbol-o"></i></a></li>
                    <li><a title="{% trans %}categories.transport{% endtrans %}" href="{{ path('map', {city: city, category: 'transport'}) }}" class="transport {% if category == 'transport' %}active{% endif %}"><i class="fa fa-bus"></i></a></li>
                    <li class="mobile_menu"><a href="#"><i class="fa fa-bars"></i></a></li>
                </ul>
            </div>
        </div>
    </div>
{% endblock %}

{% block balticrest_js_body %}
    <script src="https://api-maps.yandex.ru/2.1/?apikey={{ yandex_maps_api_key }}&lang={{ app.request.locale }}" type="text/javascript"></script>
    {{ parent() }}
    <script type="text/javascript">
        const map_data = {{ map_data|raw }};
    </script>
    {{ encore_entry_script_tags('balticrest_map') }}
{% endblock %}