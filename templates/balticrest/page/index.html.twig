                             data-speed="1000"
                             data-start="1700"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl1/marker.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lft fadeout rs-parallaxlevel-6"
                             data-x="1030"
                             data-y="260"
                             data-speed="1100"
                             data-start="1800"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl1/marker.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lft fadeout rs-parallaxlevel-6"
                             data-x="855"
                             data-y="450"
                             data-speed="1200"
                             data-start="1900"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl1/marker.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lft fadeout rs-parallaxlevel-6"
                             data-x="990"
                             data-y="560"
                             data-speed="1300"
                             data-start="2000"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl1/marker.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lft fadeout rs-parallaxlevel-4"
                             data-x="-3"
                             data-y="432"
                             data-speed="1400"
                             data-start="2100"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl1/bubble.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lft fadeout rs-parallaxlevel-4"
                             data-x="965"
                             data-y="510"
                             data-speed="1500"
                             data-start="2300"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl1/bubble.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lft fadeout rs-parallaxlevel-1"
                             data-x="center"
                             data-y="center"
                             data-speed="1600"
                             data-start="2400"
                             data-easing="Power4.easeOut">
                            <div class="sl_descrition">
                                <h1>{% trans %}slider.sl1.header{% endtrans %}<span></span></h1>
                                <span>{% trans %}slider.sl1.text{% endtrans %}</span>
                                <div class="btns">
                                    <a href="{{ path('map', {city: default_city}) }}" class="btn btn-success">
                                        {% trans %}slider.sl1.btn{% endtrans %}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </li>
                    {# 2 слайд #}
                    <li data-transition="zoomout" data-slotamount="7" data-masterspeed="1000">
                        <img src="{{ asset('/static/balticrest/images/promo/sl1/sl_bg.png') }}"  alt="darkblurbg"  data-bgfit="cover" data-bgposition="left top" data-bgrepeat="no-repeat">
                        <div class="tp-caption lfb fadeout rs-parallaxlevel-1"
                             data-x="60"
                             data-y="200"
                             data-speed="1000"
                             data-start="400"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl2/imac.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lft fadeout rs-parallaxlevel-3"
                             data-x="170"
                             data-y="350"
                             data-speed="500"
                             data-start="1200"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl2/macbook.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lft fadeout rs-parallaxlevel-7"
                             data-x="-10"
                             data-y="340"
                             data-speed="700"
                             data-start="1500"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl2/ipad.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lft fadeout rs-parallaxlevel-1"
                             data-x="500"
                             data-y="center"
                             data-speed="1000"
                             data-start="2000"
                             data-easing="Power4.easeOut">
                            <div class="sl_descrition right">
                                <h1>{% trans %}slider.sl2.header{% endtrans %}<span></span></h1>
                                <span>{% trans %}slider.sl2.text{% endtrans %}</span>
                            </div>
                        </div>
                    </li>
                    {# 3 слайд #}
                    <li data-transition="zoomout" data-slotamount="7" data-masterspeed="1000">
                        <img src="{{ asset('/static/balticrest/images/promo/sl1/sl_bg.png') }}"  alt="darkblurbg"  data-bgfit="cover" data-bgposition="left top" data-bgrepeat="no-repeat">
                        <div class="tp-caption lfb fadeout rs-parallaxlevel-5"
                             data-x="center"
                             data-y="320"
                             data-speed="1000"
                             data-start="400"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl3/h1.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lfb fadeout rs-parallaxlevel-1"
                             data-x="center"
                             data-y="340"
                             data-speed="1500"
                             data-start="700"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl3/h2.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lfb fadeout rs-parallaxlevel-10"
                             data-x="center"
                             data-y="560"
                             data-speed="2000"
                             data-start="1000"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl3/h3.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lft fadeout rs-parallaxlevel-1"
                             data-x="center"
                             data-y="top"
                             data-speed="2500"
                             data-start="1200"
                             data-easing="Power4.easeOut">
                            <div class="sl_descrition top">
                                <h1>{% trans %}slider.sl3.header{% endtrans %}<span></span></h1>
                                <span>{% trans %}slider.sl3.text{% endtrans %}</span>
                                <div class="btns">
                                    <a href="{{ path('point_list', {city: default_city, category: 'hotels'}) }}" class="btn btn-success">
                                        {% trans %}slider.sl3.btn{% endtrans %}
                                    </a>
                                </div>
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        </div>

        {# Cсылки на список #}
        <div class="category_block container-fluid">
            <div class="fixed_w">
                <h2>{% trans %}category.text{% endtrans %}</h2>
                <div class="row">
                    <div class="col-md-3 cat_item wow bounceInLeft hotels">
                        <div onclick="location.href='{{ path('point_list', {city: default_city, category: 'hotels'}) }}';">
                            <i class="fa fa-hotel"></i>
                            <h4>{% trans from "messages" %}categories.hotels{% endtrans %}</h4>
                        </div>
                    </div>
                    <div class="col-md-3 cat_item wow bounceInLeft medicine">
                        <div onclick="location.href='{{ path('point_list', {city: default_city, category: 'medicine'}) }}';">
                            <i class="fa fa-plus-square"></i>
                            <h4>{% trans from "messages" %}categories.medicine{% endtrans %}</h4>
                        </div>
                    </div>
                    <div class="col-md-3 cat_item wow bounceInRight cafes">
                        <div onclick="location.href='{{ path('point_list', {city: default_city, category: 'cafes'}) }}';">
                            <i class="fa fa-cutlery"></i>
                            <h4>{% trans from "messages" %}categories.cafes{% endtrans %}</h4>
                        </div>
                    </div>
                    <div class="col-md-3 cat_item wow bounceInRight shops">
                        <div onclick="location.href='{{ path('point_list', {city: default_city, category: 'shops'}) }}';">
                            <i class="fa fa-shopping-cart"></i>
                            <h4>{% trans from "messages" %}categories.shops{% endtrans %}</h4>
                        </div>
                    </div>
                    <div class="col-md-3 cat_item wow bounceInLeft banks">
                        <div onclick="location.href='{{ path('point_list', {city: default_city, category: 'banks'}) }}';">
                            <i class="fa fa-usd"></i>
                            <h4>{% trans from "messages" %}categories.banks{% endtrans %}</h4>
                        </div>
                    </div>
                    <div class="col-md-3 cat_item wow bounceInLeft museums">
                        <div onclick="location.href='{{ path('point_list', {city: default_city, category: 'museums'}) }}';">
                            <i class="fa fa-university"></i>
                            <h4>{% trans from "messages" %}categories.museums{% endtrans %}</h4>
                        </div>
                    </div>
                    <div class="col-md-3 cat_item wow bounceInRight sport">
                        <div onclick="location.href='{{ path('point_list', {city: default_city, category: 'sport'}) }}';">
                            <i class="fa fa-futbol-o"></i>
                            <h4>{% trans from "messages" %}categories.sport{% endtrans %}</h4>
                        </div>
                    </div>
                    <div class="col-md-3 cat_item wow bounceInRight transport">
                        <div onclick="location.href='{{ path('point_list', {city: default_city, category: 'transport'}) }}';">
                            <i class="fa fa-bus"></i>
                            <h4>{% trans from "messages" %}categories.transport{% endtrans %}</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Карта #}
        <div class="map_block container-fluid">
            <div class="map_descr">
                <span>{% trans %}map.text{% endtrans %}
                    <a href="{{ path('map', {city: default_city}) }}">{% trans %}map.btn{% endtrans %}</a>
                </span>
            </div>
            <div class="index_map" id="map"></div>
        </div>

        {# Текстовый блок #}
        <div class="promo_block container-fluid">
            <div class="fixed_w promka">
                <span>
                    {% trans %}before_news.text{% endtrans %}
                </span>
            </div>
            <div class="anim_bg"></div>
        </div>

        {# Новости #}
        <div class="places_index_block container-fluid">
            <div class="fixed_w">
                <h2>{% trans %}news.text{% endtrans %}</h2>
                <div class="row">

                    {% for key, value in news %}
                        {% if key == 1 %}
                            {% set newsClass = 'bounceInLeft' %}
                        {% elseif key == 2 %}
                            {% set newsClass = 'bounceInUp' %}
                        {% else %}
                            {% set newsClass = 'bounceInRight' %}
                        {% endif %}

                        <div class="col-md-4 place_index_item wow {{ newsClass }}">
                            <div class="place_inn">
                                <img src="{{ value.image }}">
                                <div class="pl_descr">
                                    <h4>{{ value.title }}</h4>
                                    <span>{{ value.text|striptags|spaceless|u.truncate(80, '...', false)|replace({'&nbsp;': ' '})|raw }}</span>
                                    <div class="date">{{ value.getPublishDate|format_date('long') }}</div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <a href="{{ path('news') }}" class="btn btn-success va">{% trans %}news.link{% endtrans %}</a>
            </div>
        </div>

    </div>

{% endblock %}

{% block balticrest_css_head %}
    {{ parent() }}
    {% if build_assets %}
        <link rel="stylesheet" type="text/css" href="{{ asset('/static/balticrest/build/balticrest_index.css') }}">
    {% else %}
        <link rel="stylesheet" type="text/css" href="{{ asset('/static/balticrest/src/jquery/css/settings.css') }}">
    {% endif %}
{% endblock %}

{% block balticrest_js_body %}

    {% if app.request.locale == 'ru' %}
        {% set yandex_maps_locale = 'ru' %}
    {% else %}
        {% set yandex_maps_locale = 'en' %}
    {% endif %}

    <script src="https://api-maps.yandex.ru/2.1/?apikey={{ yandex_maps_api_key }}&lang={{ yandex_maps_locale }}" type="text/javascript"></script>

    {{ parent() }}

    <script type="text/javascript">
        let map_data = {{ map_data|raw }};
    </script>

    {% if build_assets %}
        <script type="text/javascript" src="{{ asset('static/balticrest/build/balticrest_index.js') }}"></script>
    {% else %}
        <script type="text/javascript" src="{{ asset('static/balticrest/src/jquery/js/jquery.parallax-0.2-min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('static/balticrest/src/jquery/js/jquery.themepunch.revolution.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('static/balticrest/src/jquery/js/jquery.themepunch.tools.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('static/balticrest/src/wow/js/wow.min.js') }}"></script>
        <script type="text/javascript" src="{{ asset('static/balticrest/src/balticrest/js/index.js') }}"></script>
    {% endif %}

    <script type="text/javascript">

        setIndexHeight();

        $(window).resize(setIndexHeight);

        $(function() {
            new WOW().init();
        });
    </script>

{% endblock %}
