{% extends 'balticrest/base.html.twig' %}

{% trans_default_domain 'promo' %}

{% block body_attr %}onload="initializeMap()" class="promo"{% endblock %}

{% block title %}{{ parent() }} {% trans from 'seo' %}index.title{% endtrans %}{% endblock %}
{% block description %}{% trans from 'seo' %}index.desc{% endtrans %}{% endblock %}
{% block keywords %}{% trans from 'seo' %}index.keywords{% endtrans %}{% endblock %}

{% block body %}

    {% set default_city = global_service.defaultCity %}
    {% set languages = global_service.languages %}
    {% set language = app.request.locale %}

    <div class="site-overlay"></div>


    <div id="container">
        <div class="top_promo_block" id="promo_head">

            {{ include('balticrest/include/navigation.html.twig') }}

            {# Блок выбора языков #}
            {% if languages[language] is defined %}
                <div class="header_promo">
                    <div class="btn-group language-selector">
                        <button type="button" class="btn dropdown-toggle" data-toggle="dropdown">
                            {{ languages[language].title }} <span class="language icon-{{ language }}"></span>
                            <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu">
                            {% for key, values in languages %}
                                {% if key != language %}
                                    {% set route_params = app.request.attributes.get('_route_params')|merge({'_locale': key}) %}
                                    <li>
                                        <a href="{{ path(app.request.attributes.get('_route'), route_params) }}">
                                            <span class="language icon-{{ key }}"></span>
                                            {{ values.title }}
                                        </a>
                                    </li>
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endif %}

            {# Верхний блок #}
            <div class="start_description">
                <h1>{% trans %}top.header{% endtrans %}<span></span></h1>
                <span>{% trans %}top.text{% endtrans %}</span>
            </div>
            <div class="scroll_block">
                <img src="{{ asset('/static/balticrest/images/promo/scroll.png') }}" class="animated infinite bounce" alt="#">
            </div>
        </div>

        {# Блок фич сайта #}
        <div class="fea_block container-fluid">
            <div class="fixed_w">
                <h2>{% trans %}features.header{% endtrans %}</h2>
                <div class="row">
                    <div class="col-md-4 fea_item wow bounceInUp">
                        <h3><i class="fa fa-globe"></i>{% trans %}features.f1.header{% endtrans %}</h3>
                        <span>{% trans %}features.f1.text{% endtrans %}</span>
                    </div>
                    <div class="col-md-4 fea_item wow bounceInUp">
                        <h3><i class="fa fa-glass"></i>{% trans %}features.f2.header{% endtrans %}</h3>
                        <span>{% trans %}features.f2.text{% endtrans %}</span>
                    </div>
                    <div class="col-md-4 fea_item wow bounceInUp">
                        <h3><i class="fa fa-university"></i>{% trans %}features.f4.header{% endtrans %}</h3>
                        <span>{% trans %}features.f4.text{% endtrans %}</span>
                    </div>
                    <div class="col-md-4 fea_item wow bounceInUp">
                        <h3><i class="fa fa-newspaper-o"></i>{% trans %}features.f5.header{% endtrans %}</h3>
                        <span>{% trans %}features.f5.text{% endtrans %}</span>
                    </div>
                    <div class="col-md-4 fea_item wow bounceInUp">
                        <h3><i class="fa fa-car"></i>{% trans %}features.f3.header{% endtrans %}</h3>
                        <span>{% trans %}features.f3.text{% endtrans %}</span>
                    </div>
                </div>
            </div>
        </div>

        {# Блок слайдшоу #}
        <div class="tp-banner-container">
            <div class="tp-banner" >
                <ul>
                    <li data-transition="zoomout" data-slotamount="7" data-masterspeed="1000">
                        <img src="{{ asset('/static/balticrest/images/promo/sl1/sl_bg.png') }}"  alt="darkblurbg"  data-bgfit="cover" data-bgposition="left top" data-bgrepeat="no-repeat">
                        <div class="tp-caption lfb fadeout rs-parallaxlevel-10"
                             data-x="center"
                             data-y="bottom"
                             data-speed="1000"
                             data-start="400"
                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl1/map.png') }}" alt="#">
                        </div>
