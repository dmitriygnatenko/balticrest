                             data-easing="Power4.easeOut">
                            <img src="{{ asset('/static/balticrest/images/promo/sl1/dott.png') }}" alt="#">
                        </div>
                        <div class="tp-caption lft fadeout rs-parallaxlevel-8"
                             data-x="950"
