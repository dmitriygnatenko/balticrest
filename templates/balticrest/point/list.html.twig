{% extends 'balticrest/base_left_top_menu.html.twig' %}

{% set city = app.request.attributes.get('city', '') %}
{% set category = app.request.attributes.get('category', '') %}

{% block title %}{{ parent() }} {{ global_service.listPageTitle(city, category) }}{% endblock %}
{% block description %}{{ global_service.listPageDescription(city, category) }}{% endblock %}
{% block keywords %}{{ global_service.listPageKeywords(city, category) }}{% endblock %}

{% block body_attr %}class="innerpage"{% endblock %}

{% block content %}

    <div class="container page_info">
        <div class="col_md_12">
            <h1>{{ global_service.listPageTitle(city, category) }}</h1>
            <div class="return-block">
                <a href="{{ path('main') }}">&crarr; {% trans %}links.to_mainpage{% endtrans %}</a>
            </div>
        </div>
        <div class="visible-sm visible-xs">
            <ul class="places_cat top">
                {% if point_types['hotels'] is defined %}
                    <li>
                        <a title="{% trans %}categories.hotels{% endtrans %}" href="{{ path('point_list', {city: city, category: 'hotels'}) }}" class="{% if category == 'hotels' %}active{% endif %}">
                            {% trans %}categories.hotels{% endtrans %}
                        </a>
                    </li>
                {% endif %}

                {% if point_types['medicine'] is defined %}
                    <li>
                        <a title="{% trans %}categories.medicine{% endtrans %}" href="{{ path('point_list', {city: city, category: 'medicine'}) }}" class="{% if category == 'medicine' %}active{% endif %}">
                            {% trans %}categories.medicine{% endtrans %}
                        </a>
                    </li>
                {% endif %}

                {% if point_types['cafes'] is defined %}
                    <li>
                        <a title="{% trans %}categories.cafes{% endtrans %}" href="{{ path('point_list', {city: city, category: 'cafes'}) }}" class="{% if category == 'cafes' %}active{% endif %}">
                            {% trans %}categories.cafes{% endtrans %}
                        </a>
                    </li>
                {% endif %}

                {% if point_types['shops'] is defined %}
                    <li>
                        <a title="{% trans %}categories.shops{% endtrans %}" href="{{ path('point_list', {city: city, category: 'shops'}) }}" class="{% if category == 'shops' %}active{% endif %}">
                            {% trans %}categories.shops{% endtrans %}
                        </a>
                    </li>
                {% endif %}

                {% if point_types['banks'] is defined %}
                    <li>
                        <a title="{% trans %}categories.banks{% endtrans %}" href="{{ path('point_list', {city: city, category: 'banks'}) }}" class="{% if category == 'banks' %}active{% endif %}">
                            {% trans %}categories.banks{% endtrans %}
                        </a>
                    </li>
                {% endif %}

                {% if point_types['museums'] is defined %}
                    <li>
                        <a title="{% trans %}categories.museums{% endtrans %}" href="{{ path('point_list', {city: city, category: 'museums'}) }}" class="{% if category == 'museums' %}active{% endif %}">
                            {% trans %}categories.museums{% endtrans %}
                        </a>
                    </li>
                {% endif %}

                {% if point_types['sport'] is defined %}
                    <li>
                        <a title="{% trans %}categories.sport{% endtrans %}" href="{{ path('point_list', {city: city, category: 'sport'}) }}" class="{% if category == 'sport' %}active{% endif %}">
                            {% trans %}categories.sport{% endtrans %}
                        </a>
                    </li>
                {% endif %}

                {% if point_types['transport'] is defined %}
                    <li>
                        <a title="{% trans %}categories.transport{% endtrans %}" href="{{ path('point_list', {city: city, category: 'transport'}) }}" class="{% if category == 'transport' %}active{% endif %}">
                            {% trans %}categories.transport{% endtrans %}
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>

    <div class="container contant">
        <div class="row cont">

            <div class="col-md-3 mobile_none sidebar">
                <ul class="places_cat">

                    {% if point_types['hotels'] is defined %}
                        <li>
                            <a title="{% trans %}categories.hotels{% endtrans %}" href="{{ path('point_list', {city: city, category: 'hotels'}) }}" class="{% if category == 'hotels' %}active{% endif %}">
                                <span><i class="fa fa-hotel"></i></span>
                                {% trans %}categories.hotels{% endtrans %}
                            </a>
                        </li>
                    {% endif %}

                    {% if point_types['medicine'] is defined %}
                        <li>
                            <a title="{% trans %}categories.medicine{% endtrans %}" href="{{ path('point_list', {city: city, category: 'medicine'}) }}" class="{% if category == 'medicine' %}active{% endif %}">
                                <span><i class="fa fa-plus-square"></i></span>
                                {% trans %}categories.medicine{% endtrans %}
                            </a>
                        </li>
                    {% endif %}

                    {% if point_types['cafes'] is defined %}
                        <li>
                            <a title="{% trans %}categories.cafes{% endtrans %}" href="{{ path('point_list', {city: city, category: 'cafes'}) }}" class="{% if category == 'cafes' %}active{% endif %}">
                                <span><i class="fa fa-cutlery"></i></span>
                                {% trans %}categories.cafes{% endtrans %}
                            </a>
                        </li>
                    {% endif %}

                    {% if point_types['shops'] is defined %}
                        <li>
                            <a title="{% trans %}categories.shops{% endtrans %}" href="{{ path('point_list', {city: city, category: 'shops'}) }}" class="{% if category == 'shops' %}active{% endif %}">
                                <span><i class="fa fa-shopping-cart"></i></span>
                                {% trans %}categories.shops{% endtrans %}
                            </a>
                        </li>
                    {% endif %}

                    {% if point_types['banks'] is defined %}
                        <li>
                            <a title="{% trans %}categories.banks{% endtrans %}" href="{{ path('point_list', {city: city, category: 'banks'}) }}" class="{% if category == 'banks' %}active{% endif %}">
                                <span><i class="fa fa-usd"></i></span>
                                {% trans %}categories.banks{% endtrans %}
                            </a>
                        </li>
                    {% endif %}

                    {% if point_types['museums'] is defined %}
                        <li>
                            <a title="{% trans %}categories.museums{% endtrans %}" href="{{ path('point_list', {city: city, category: 'museums'}) }}" class="{% if category == 'museums' %}active{% endif %}">
                                <span><i class="fa fa-university"></i></span>
                                {% trans %}categories.museums{% endtrans %}
                            </a>
                        </li>
                    {% endif %}

                    {% if point_types['sport'] is defined %}
                        <li>
                            <a title="{% trans %}categories.sport{% endtrans %}" href="{{ path('point_list', {city: city, category: 'sport'}) }}" class="{% if category == 'sport' %}active{% endif %}">
                                <span><i class="fa fa-futbol-o"></i></span>
                                {% trans %}categories.sport{% endtrans %}
                            </a>
                        </li>
                    {% endif %}

                    {% if point_types['transport'] is defined %}
                        <li>
                            <a title="{% trans %}categories.transport{% endtrans %}" href="{{ path('point_list', {city: city, category: 'transport'}) }}" class="{% if category == 'transport' %}active{% endif %}">
                                <span><i class="fa fa-bus"></i></span>
                                {% trans %}categories.transport{% endtrans %}
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>

            <div class="col-md-9 basic">
                <div class="place_li_cont">

                    {% for point in list_data %}
                        <div class="pg style_list">
                            <div class="con">
                                <img src="{{ point.image }}">
                                <div class="content_li">
                                    <h2>
                                        <a href="{{ point.link }}">{{ point.title }}</a>
                                        {% if point.description != false %}
                                            <span></span>
                                        {% endif %}
                                    </h2>
                                    <div>
                                        {{ point.description|raw }}
                                    </div>
                                </div>
                            </div>
                            {% if schedule_data[point.url] is defined %}
                                {% set schedule = schedule_data[point.url]%}
                                {{ include('balticrest/include/schedule.html.twig') }}
                            {% endif  %}
                        </div>
                    {% endfor %}

                </div>
            </div>
        </div>
    </div>
{% endblock %}