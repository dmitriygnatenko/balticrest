{% extends 'balticrest/base_left_top_menu.html.twig' %}

{% block title %}{% trans %}login.title{% endtrans %} - {{ parent() }}{% endblock %}

{% block body_attr %}class="innerpage"{% endblock %}

{% block content %}
    <div class="login_form">
        <h3>
            {% trans %}login.form.title{% endtrans %}
            <span></span>
        </h3>

        {% if error %}
            <div class="errors">{{ error.message }}</div>
        {% endif %}

        {% if not error %}
            <div class="social">
                <a href="{{ vk_url }}" class="vk" title="{% trans %}login.form.label.vk{% endtrans %}"></a>
                <a href="{{ fb_url }}" class="fb" title="{% trans %}login.form.label.fb{% endtrans %}"></a>
            </div>
        {% endif %}

        <form method="post">
            <label>
                {% trans %}login.form.label.email{% endtrans %}:<input type="text" name="email" value="{{ last_username }}">
            </label>
            <label>
                {% trans %}login.form.label.password{% endtrans %}:<input type="password" name="password">
            </label>
            <button class="btn btn-primary" type="submit">
                {% trans %}login.form.button.login{% endtrans %}
            </button>
            <a href="{{ path('register') }}" class="btn btn-success">
                {% trans %}login.form.button.register{% endtrans %}
            </a>

            {% if error %}
                <a href="{{ path('restore') }}" class="btn btn-success">
                    {% trans %}login.form.button.restore{% endtrans %}
                </a>
            {% endif %}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        </form>
    </div>
{% endblock %}
