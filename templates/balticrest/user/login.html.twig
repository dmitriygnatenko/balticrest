{% extends 'balticrest/base_left_top_menu.html.twig' %}

{% block title %}{{ parent() }} - {% trans from 'seo' %}login.title{% endtrans %}{% endblock %}
{% block description %}{% trans from 'seo' %}login.desc{% endtrans %}{% endblock %}
{% block keywords %}{% trans from 'seo' %}login.keywords{% endtrans %}{% endblock %}

{% trans_default_domain 'auth' %}

{% block body_attr %}class="innerpage"{% endblock %}

{% block content %}
    <div class="login_form">
        <h3>
            {% trans %}login.title{% endtrans %}
            <span></span>
        </h3>

        {% if error %}
            <div class="errors">{{ error.message|raw }}</div>
        {% endif %}

        {% if not error %}
            <div class="social">
                <a href="{{ vk_url }}" class="vk" title="{% trans %}login.form.label.vk{% endtrans %}"></a>
                <a href="{{ fb_url }}" class="fb" title="{% trans %}login.form.label.fb{% endtrans %}"></a>
            </div>
        {% endif %}

        <form method="post">
            <div class="form-group {% if error.messageData.email is defined %}has-error{% endif %}">
                <label>
                    {% trans %}login.form.label.email {% endtrans %}:

                    <input type="text" name="email" class="form-control" value="{{ last_username }}">
                </label>
            </div>

            <div class="form-group {% if error.messageData.password is defined %}has-error{% endif %}">
                <label>
                    {% trans %}login.form.label.password{% endtrans %}:
                    <input type="password" name="password" class="form-control">
                </label>
            </div>

            <button class="btn btn-primary" type="submit">
                {% trans %}login.form.button.login{% endtrans %}
            </button>

            <a href="{{ path('registration') }}" class="btn btn-success">
                {% trans %}login.form.button.register{% endtrans %}
            </a>

            {% if error %}
                <a href="{{ path('restore') }}" class="btn btn-success">
                    {% trans %}login.form.button.restore{% endtrans %}
                </a>
            {% endif %}
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        </form>
    </div>
{% endblock %}
