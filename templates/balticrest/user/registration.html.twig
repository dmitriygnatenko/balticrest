{% extends 'balticrest/base_left_top_menu.html.twig' %}

{% block title %}{{ parent() }} - {% trans %}registration.title{% endtrans %}{% endblock %}

{% block body_attr %}class="innerpage"{% endblock %}

{% block content %}
    <div class="login_form">
        <h3>
            {% trans %}registration.title{% endtrans %}
            <span></span>
        </h3>

        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

            {% set form_errors = form.vars.errors.form.getErrors(true) %}

            <div class="errors">
                {% if form_errors|length %}
                    {% for error in form_errors %}
                        {{ error.message|raw }}<br>
                    {% endfor %}
                {% endif %}
            </div>

            <div class="form-group {% if form_errors(form.username) %}has-error{% endif %}">
                <label>
                    {{ form.username.vars.label|trans }}:
                    {{ form_widget(form.username, {'attr': {'class': 'form-control'}}) }}
                </label>
            </div>

            <div class="form-group {% if form_errors(form.email) %}has-error{% endif %}">
                <label>
                    {{ form.email.vars.label|trans }}:
                    {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                </label>
            </div>

            <button class="btn btn-success" type="submit">
                {% trans %}registration.form.button.register{% endtrans %}
            </button>

        {{ form_end(form) }}
    </div>
{% endblock %}
